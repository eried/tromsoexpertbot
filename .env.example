# Telegram Bot Token (get from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Admin Chat ID (your Telegram user ID for admin commands like /scan, /peek, /simonsays)
# You can get your chat ID by messaging @userinfobot on Telegram
ADMIN_CHAT_ID=0

# Optional: Pterodactyl panel integration for remote status file hosting
# PTERODACTYL_API_KEY=your_api_key_here
# PTERODACTYL_PANEL_URL=https://your-panel.example.com
# PTERODACTYL_SERVER_ID=your_server_id

# Optional: Enable calibration image saving (saves hourly snapshots for tuning)
# SAVE_CALIBRATION_IMAGES=true

# Optional: Enable/disable photo archiving (default: true)
# ARCHIVE_ENABLED=true
